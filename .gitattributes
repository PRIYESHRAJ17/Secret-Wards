# Enforce LF line endings on all text files and test fixtures
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.sh text eol=lf

# Binary assets (never alter bytes)
*.pdf binary
*.jpg binary
*.jpeg binary
*.png binary
*.zip binary
*.gz binary
*.bin binary
*.crfsuite binary
